# Loaded by direnv whenever you cd into this repository (tools/setup_env.sh installs
# direnv and allows this file once). It puts the course venv first on PATH, so plain
# `python` / `python3` / `pytest` are the course interpreter here and nowhere else.
export VIRTUAL_ENV="${MLSYS_VENV:-$HOME/venvs/mlsys}"
PATH_add "$VIRTUAL_ENV/bin"
